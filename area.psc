Algoritmo area
	Definir  base Como Real
	Definir altura Como Real 
	
	
	Escribir "Calcular el area de un triangulo"
	Escribir Sin Saltar "Escribe la base"
	Leer base
	Escribir Sin Saltar "Escribe la altura"
	Leer altura
	
		
		Si (base > 0 y altura > 0 ) Entonces
			Escribir "El área del triangulo es : ", base*altura/2
		SiNo
			Escribir "Pon numeros reales"
			
		Fin Si
	
FinAlgoritmo

